            [0x0, 0x11, 0x12, 0x2, me._dev.dev1, me._dev.dev2, 0x0, 0x0, 0x1c, 0x1, 0x0, 0x0, 0x76, 0x72, 0x19, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0]
        ];
        foreach (var pkt; initCommand ) {
            me._device.sendOutputReport(240,pkt);
        };
        logprint(LOG_DEBUG,"MCDU initialized!");
        me._mcduProps.init.setIntValue(1);
        me.initMsg();
    },
    updateLines: func() {
        me._screenProps.line1.setValue(me._inputProps.line0.getValue());
        var txtLines = {};
        for ( var i=1; i < 7; i += 1) {
            var line = i*2 + 1;
            var text = me._inputProps["line"~i].getValue();
            txtLines["line"~line] = me.formatLines(text);
            me._screenProps["line"~line].setValue(txtLines["line"~line][0]);
            # change line for sublines
            var line = i*2;
            var text = me._inputProps["line"~i~"S"].getValue();
            txtLines["line"~line] = me.formatLines(text);
            me._screenProps["line"~line].setValue(txtLines["line"~line][0]);
        }
        return txtLines;
    },
    formatLines: func(line) {
        var splitty = split(";",line);
        var left = splitty[0];
        var center = splitty[1];
        var right = splitty[2];
        var ls = utf8.size(left);
        var cs = utf8.size(center);
        var rs = utf8.size(right);
        var ts = ls + cs + rs;
        var text = "";
        if (ts > 24) {
            logprint(LOG_DEBUG,"MIND THE GAP "~line~" "~ls~" "~cs~" "~rs);
            #print("MIND THE GAP;"~left~"; "~center~";"~right);
            #right = substr(right,0,rs-(24-ls-cs));
            center = utf8.substr(center,0,cs+(24-ts)-1);
            #print("MIND THE GAP "~size(left)~" "~size(center)~" "~size(right));
        } else if ( ts < 24) {
            if (cs == 0) {
                left = left ~ padStr("",24-ts)
            } else {
                var csz = cs/2;
                if ( rs >= 8 ) {
                    var lgap = (24-cs-(rs+1))-ls;
                    var rgap = 1;
                } else if ( ls >= 8 ) {
                    var rgap = (24-cs-(ls+1))-rs;
                    var lgap = 1;
                } else {
                    var lgap = 12 - ls -  math.ceil(csz);
                    var rgap = 12 - rs - math.floor(csz);
                }
                #print("lgap/rgap: "~lgap~"/"~rgap);
                #if (rgap < 0) {
                #    lgap = lgap + rgap - 1;
                #    rgap = 1;
                #}
                #print("lgap/rgap: "~lgap~"/"~rgap);
                left = left ~ padStr("",lgap);
                center = center ~ padStr("",rgap);
            }
        }
        #print("|      ||      ||      |");
        #print(text);
        #print(line);
        text = left ~ center ~ right;
        return [ text, utf8.size(left), utf8.size(center), utf8.size(right) ];
    },

    updateColors: func(lineArr) {
        # TODO rewrite
        # this is all transposed from an eariler implementation
        # that exported the colors as 6 properties of a LCR line.
        for ( var i=0; i < 6; i += 1) {
            var line = i*2 + 3;
            var j = i+1;
            var farben = split(";",me._colorProps["line"~j~"_color"].getValue());
            var sizer = split(";",me._sizeProps["line"~j~"_size"].getValue());
            var cl = padStr("",lineArr["line"~line][1],me._mcduc[farben[0]]);
            var cc = padStr("",lineArr["line"~line][2],me._mcduc[farben[1]]);
            var cr = padStr("",lineArr["line"~line][3],me._mcduc[farben[2]]);
            if (sizer[0] <= 48) {
                cl = string.lc(cl);
            }
            if (sizer[1] <= 48) {
                cc = string.lc(cc);
            }
            if (sizer[2] <= 48) {
                cr = string.lc(cr);
            }
            me._screenProps["color"~line].setValue(cl~cc~cr);
        }
        for ( var i=0; i < 6; i += 1) {
            var line = i*2 + 2;
            var j = i+1;
            var farben = split(";",me._colorProps["line"~j~"S_color"].getValue());
            var sizer = split(";",me._sizeProps["line"~j~"S_size"].getValue());
            var cl = padStr("",lineArr["line"~line][1],me._mcduc[farben[0]]);
            var cc = padStr("",lineArr["line"~line][2],me._mcduc[farben[1]]);
            var cr = padStr("",lineArr["line"~line][3],me._mcduc[farben[2]]);
            if (sizer[0] <= 48) {
                cl = string.lc(cl);
            }
            if (sizer[1] <= 48) {
                cc = string.lc(cc);
            }
            if (sizer[2] <= 48) {
                cr = string.lc(cr);
            }
            me._screenProps["color"~line].setValue(cl~cc~cr);
        }
        var sp_color = padStr("",24,me._mcduc[me._colorProps.scratchpad.getValue()]);
        var title_color = padStr("",24,me._mcduc[split(";",me._colorProps.line0_color.getValue())[0]]);
        if (split(";",me._sizeProps.line0_size.getValue())[0] <= 48) {
            title_color = string.lc(title_color);
        }
        me._screenProps.color1.setValue(title_color);
        me._screenProps.color14.setValue(sp_color);
        #print("MCDU colors updated!");
    },
    buildCommand: func() {
        if ( me._mcduProps.init.getValue() != 1) {
            logprint(LOG_DEBUG,"MCDU not init!");
            return;
        }
        if ( me._mcduProps.msgCounter.getValue() != 17) {
            logprint(LOG_DEBUG,"MCDU not ready!");
            me._mcduProps.waiting.setIntValue(1);
            return;
        }
        #print("MCDU building message");
        me._mcduProps.msgCounter.setIntValue(0);
        me._screenProps.line14.setValue(me._inputProps.scratchpad.getValue());
        var liners = me.updateLines();
        me.updateColors(liners);
