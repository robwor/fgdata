# MCDU

winctrl["mcdu32"] = {
    new: func(cfgnode,device) {
        var m = {
            parents: [me, input_helpers.config_manager.new(cfgnode)],
        };
        me._device = device;
        me.type = check_family();
        me.path = "/input/winctrl/mcdu32";
        me.listeners = [];
        me.leds = {};
        foreach (var l; keys(me._led)) {
            var devs = [me._dev.dev1,me._dev.dev2];
            var prop = m.path~"/leds/"~l;
            me.leds[l] = leddy.new(l,devs,me._led[l],prop);
            append(me.listeners,me.leds[l].autoReport(me._device));
        }
        me.leds.ledBrt.set(255);
        me.leds.disp.set(64);
        foreach (var prop; keys(me._mcduProps)) {
            me._mcduProps[prop].setIntValue(0);
        }
        foreach (var prop; keys(me._screenProps)) {
            me._screenProps[prop].setValue("");
        }
        foreach (var prop; keys(me._inputProps)) {
            me._inputProps[prop].setValue(";;");
        }
        foreach (var prop; keys(me._colorProps)) {
            me._colorProps[prop].setValue("wht;wht;wht");
        }
        me._colorProps.scratchpad.setValue('wht');
        foreach (var prop; keys(me._sizeProps)) {
            me._sizeProps[prop].setValue("60;60;60");
        }
        me._mcduProps.msgCounter.setIntValue(17);
        if (me.type == 'A320') {
            me.doAirbus();
        }
        me.initDisplay();
        me.watchMCDU();
        me.initMsg();
        logprint(LOG_INFO,"WINCTRL MCDU ONLINE");
        return me;
    },
    close: func(cfgnode) {
        logprint(LOG_DEBUG,"removing "~size(me.listeners)~" listeners");
        foreach (var id; me.listeners) {
            removelistener(id);
        }
        if (contains(keys(me),'_device')) {
            foreach (var led; keys(me.leds)) {
                me.leds[led].close(me._device);
            }
        }
        logprint(LOG_INFO,"WINCTRL MCDU shutdown");
    },
    _ledWatchProps: {
        "panel": props.globals.getNode("/controls/lighting/main-panel-norm", 1),
        "disp": props.globals.getNode("/controls/lighting/DU/mcdu1", 1),
        "annFail": props.globals.getNode("/controls/indicators/mcdu-capt-ann-fail", 1),
        "annFm": props.globals.getNode("/controls/indicators/mcdu-capt-ann-fm", 1),
        "annFm1": props.globals.getNode("/controls/indicators/mcdu-capt-ann-fm1", 1),
        "annFm2": props.globals.getNode("/controls/indicators/mcdu-capt-ann-fm2", 1),
        "annMsg1": props.globals.getNode("/controls/indicators/mcdu-capt-ann-msg", 1),
        "annMsg2": props.globals.getNode("/controls/indicators/mcdu-capt-ann-msg", 1),
        "annInd": props.globals.getNode("/controls/indicators/mcdu-capt-ann-ind", 1),
