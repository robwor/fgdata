            [0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0],
        ];
        var lines = [];
        var colorLines = [];
        for (var i = 1; i < 15; i += 1) {
            append(lines,me._screenProps["line"~i].getValue());
            append(colorLines,me._screenProps["color"~i].getValue());
        }
        # Make sure we have 24 character long lines
        for (var i = 0; i < 14; i += 1) {
            if (utf8.size(lines[i]) > 24) {
                logprint(LOG_INFO,lines[i]);
                logprint(LOG_INFO,"ERROR: MCDU Line "~i~" over 24| characters long!");
                logprint(LOG_INFO,"Size/utf8size: "~size(lines[i])~" "~utf8.size(lines[i]));
                lines[i] = utf8.substr(lines[i],0,24);
            }
            while (utf8.size(lines[i]) < 24) {
                lines[i] = lines[i] ~ " ";
            }
            if (utf8.size(colorLines[i]) > 24) {
                logprint(LOG_INFO,"ERROR: MCDU Color over 24 characters long!");
                colorLines[i] = utf8.substr(colorLines[i],0,24);
                #return;
            }
            while (utf8.size(colorLines[i]) < 24) {
                colorLines[i] = colorLines[i] ~ "W";
            }
        }
        var byteCounter = 0;
        var commandLineCounter = 0;
        for (var i = 0; i < 14; i += 1) {
            for (var j = 0; j < 24; j += 1) {
                var pkt = [];
                var farge = chr(colorLines[i][j]);
                var fbyte = me._colors[string.uc(farge)];
                if ( string.islower(colorLines[i][j])) {
                    fbyte = fbyte + 0x016b;
                }
                #print(farge~sprintf(" 0x%04X",fbyte));
                append(pkt,fbyte & 0xff);
                append(pkt,rshift(fbyte,8) & 0xff);
                # next bytes can vary, usually just 1 but can be 3
                # testChar is important for multi-byte characters
                fixed = testChar(utf8.strc(lines[i],j));
                # TODO there has to be a more sane way of calculating and doing this
                var fsize = size(sprintf("%x",fixed))*4/8;
                #print(sprintf("0x%06X",fixed)~" "~fsize);
                if (fsize > 1) {
                    while (fsize > 1) {
                        fsize -=1;
                        append(pkt, rshift(fixed,(fsize*8)) & 0xff);
                    }
                }
                append(pkt,fixed & 0xff);
                #print(sprintf("utf: 0x%06X pkt2: 0x%06X pkt1: 0x%06X",utfchr,pkt[2],pkt[1]));
                # command lines can break in the middle of character sequences
                # would it be better to generate whole thing, then split later?
                foreach ( var slot; pkt ) {
                    command[commandLineCounter][byteCounter] = slot;
                    byteCounter += 1;
                    if (byteCounter >= 63) {
                        byteCounter = 0;
                        commandLineCounter += 1;
                        #print("newPage: "~commandLineCounter);
                    }
                }
            }
        }
        while (commandLineCounter < 17) {
            while (byteCounter < 63) {
                command[commandLineCounter][byteCounter] = 0x00;
                byteCounter += 1;
            }
            byteCounter = 0;
            commandLineCounter += 1;
        }
        #print("MCDU message ready!");
        me._perf.tzero = systime();
        me.send2Dev(command);
        #var upd8 = me._mcduProps.update.getValue();
        #me._mcduProps.update.setIntValue(math.mod(upd8+1,2));
    },
    send2Dev: func(cmd) {
        logprint(LOG_DEBUG,"sending MCDU message");
        foreach (var pkt; cmd ) {
            #debug.dump(pkt);
            me._device.sendOutputReport(242,pkt);
        };
        var complete = func() {
            me._mcduProps.msgCounter.setIntValue(17);
            var counter = me._mcduProps.msgCounter.getValue();
            if ( me._mcduProps.waiting.getValue() == 1) {
                logprint(LOG_DEBUG,"MCDU message waiting");
                var upd8 = me._mcduProps.update.getValue();
                me._mcduProps.waiting.setIntValue(0);
                me._mcduProps.update.setIntValue(math.mod(upd8+1,2));
            }
            logprint(LOG_DEBUG,"MCDU sendOutput loop: "~(systime()-me._perf.tzero));
        };
        # ultra-short timer to just skip a frame
        var timer = maketimer(0.002,me,complete);
        timer.singleShot = 1;
        timer.start();
    },
};

var testChar = func(val) {
    # TODO make a mapping hash for these
    if ((val == 194) or (val == 176)) {
        #print("Degrees °!");
        val = 0xc2b0;
    }
    # 171 «
    if ((val == 171)) {
        #print(" arrow < ");
        val = 0xe28690;
    }
    # 187 »
    if ((val == 187)) {
        #print(" arrow > ");
        val = 0xe28692;
    }
    # @ symbol hides as triangle
    if ((val == 64)) {
        val = 0xce94;
    }
    # 161 ¡
    # 191 ¿
    # 164 ¤
    # square = 0xe29890;
    if  ((val == 164 )) {
        val = 0xe29890;
    }
    #print("val: "~val~" "~sprintf("0x%02X",val));
    # <- = 0xe28690; 60
    # ^ = 0xe28691;
    # -> = 0xe28692; 62
    # down arrow = 0xe28693;
    # # = 0xe29890; 35 #? box?
    # rhombus = 0xe2aca1;
    # top triangle = 0xcd94;
    # deg = 0xc2b0;
    # closed left triangle = 0xe29780;
    # closed right triangle = 0xe296b6;
    return val;
};
