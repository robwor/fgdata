        "annDash": props.globals.getNode("/controls/indicators/mcdu-capt-ann-dash", 1),
    },
    _dev: {
        'dev1': 0x32,
        'dev2': 0xBB,
    },
    _led: {
        'panel': 0x00,
        'disp': 0x01,
        'ledBrt': 0x02,
        'annFm2': 0x10,
        'annDash': 0x0f,
        'annRdy': 0x0e,
        'annInd': 0x0d,
        'annFm1': 0x0c,
        'annMsg2': 0x0b,
        'annMsg1': 0x0a,
        'annFm': 0x09,
