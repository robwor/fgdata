        'A': 0x0021, # Amber
        'W': 0x0042, # White
        'C': 0x0063, # Cyan
        'G': 0x0084, # Green
        'M': 0x00a5, # Magenta
        'R': 0x00c6, # Red
        'Y': 0x00e7, # Yellow
        'E': 0x0108, # grEy
        'L': 0x0000, # black with grey background
    },
    _mcduc: {
        'wht': 'W',
        'grn': 'G',
        'blu': 'C',
        'amb': 'A',
        'ack': 'W',
        'yel': 'Y',
        'mag': 'M',
        'red': 'R',
        'gry': 'E',
        'blk': 'L',
