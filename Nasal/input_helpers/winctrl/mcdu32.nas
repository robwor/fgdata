# MCDU

winctrl["mcdu32"] = {
    new: func(cfgnode,device,mcduType="capt") {
        var m = {
            parents: [me, input_helpers.config_manager.new(cfgnode)],
        };
        m._device = device;
        # TODO auto-detect which MCDU we have, capt fo obs
        m.variant = m._types[mcduType];
        m.type = check_family();
        m.path = "/input/winctrl/mcdu32/"~m.variant.suffix;
        m.listeners = [];
        m.leds = {};
        foreach (var l; keys(m._led)) {
            var devs = [m.variant.dev1,m.variant.dev2];
            var prop = m.path~"/leds/"~l;
            m.leds[l] = leddy.new(l,devs,m._led[l],prop);
            append(m.listeners,m.leds[l].autoReport(m._device));
        }
        m.leds.ledBrt.set(255);
        m.leds.disp.set(64);
        m.setupProps();
        m._mcduProps.msgCounter.setIntValue(17);
        if (m.type == 'A320') {
            m.doAirbus();
        } else {
            m.doOthers();
        }
        m.initDisplay();
        m.watchMCDU();
        m.initMsg();
        logprint(LOG_INFO,"WINCTRL MCDU "~m.variant.name~" ONLINE");
        return m;
    },
    close: func(cfgnode) {
        logprint(LOG_DEBUG,"removing "~size(me.listeners)~" listeners");
        foreach (var id; me.listeners) {
            removelistener(id);
        }
        if (contains(keys(me),'_device')) {
            foreach (var led; keys(me.leds)) {
                me.leds[led].close(me._device);
            }
        }
        logprint(LOG_INFO,"WINCTRL MCDU shutdown");
    },
    _types: {
        'capt': {
            'mcdu': 0,
            'suffix': 'capt',
            'name': 'CAPTAIN',
            'dev1': 0x32,
            'dev2': 0xBB,
        },
        'fo': {
            'mcdu': 1,
            'suffix': 'fo',
            'name': "CO-PILOT",
            'dev1': 0x32,
            'dev2': 0xBB,
        },
        'obs': {
            'mcdu': 2,
            'suffix': 'obs',
            'name': "OBSERVER",
            'dev1': 0x32,
            'dev2': 0xBB,
        },
    },
    _led: {
        'panel': 0x00,
        'disp': 0x01,
        'ledBrt': 0x02,
        'annFm2': 0x10,
        'annDash': 0x0f,
        'annRdy': 0x0e,
        'annInd': 0x0d,
        'annFm1': 0x0c,
        'annMsg2': 0x0b,
        'annMsg1': 0x0a,
        'annFm': 0x09,
        'annFail': 0x08,
    },
    # harder stuff, screen
    setupProps: func() {
        var mcduProps = ["init","waiting","writeCounter","msgCounter","update"];
        me._mcduProps = {};
        me._screenProps = {};
        foreach (var prop; mcduProps) {
            me._mcduProps[prop] = props.globals.getNode(me.path~"/"~prop,1);
            me._mcduProps[prop].setIntValue(0);
        }
        for (var j=1;j<=14;j+=1) {
            var name = "line"~j;
            var color = "color"~j;
            me._screenProps[name] = props.globals.getNode(me.path~"/text/"~name,1);
            me._screenProps[name].setValue("");
            me._screenProps[color] = props.globals.getNode(me.path~"/text/"~color,1);
            me._screenProps[color].setValue("");
        }
        me._mcdu32Devs = {
            "lux1": props.globals.getNode(me.path~"/lux1", 1),
            "lux2": props.globals.getNode(me.path~"/lux2", 1),
        };
        me._inputProps = {};
        me._colorProps = {};
        me._sizeProps = {};
    },
    _colors: {
        'A': 0x0021, # Amber
        'W': 0x0042, # White
        'C': 0x0063, # Cyan
        'G': 0x0084, # Green
        'M': 0x00a5, # Magenta
        'R': 0x00c6, # Red
        'Y': 0x00e7, # Yellow
        'E': 0x0108, # grEy
        'L': 0x0000, # black with grey background
    },
    _mcduc: {
        'wht': 'W',
        'grn': 'G',
        'blu': 'C',
        'amb': 'A',
        'ack': 'W',
        'yel': 'Y',
        'mag': 'M',
        'red': 'R',
        'gry': 'E',
        'blk': 'L',
    },
    _perf: {
        'tzero': systime(),
    },
    watchLEDs: func() {
        foreach(var led; keys(me._ledWatchProps)) {
            append(me.listeners,me.leds[led].watch(me._ledWatchProps[led]));
        }
    },
    watchMCDU: func() {
        # TODO: watch winctrl props, not airbus props
        # using formatting from props like 'l;c;r' and matching colors
        foreach(var mcduLine; keys(me._screenProps)) {
            append(me.listeners,setlistener(me._screenProps[mcduLine],func() { me.buildCommand();},0,0));
        }
        append(me.listeners,setlistener(me._mcduProps.update,func() { me.buildCommand();},1,0));
    },
    doAirbus: func() {
        var mcdupp = me.variant.mcdu + 1;
        me._ledWatchProps = {
            "panel": props.globals.getNode("/controls/lighting/main-panel-norm", 1),
            "disp": props.globals.getNode("/controls/lighting/DU/mcdu"~mcdupp, 1),
            "annFail": props.globals.getNode("/controls/indicators/mcdu-"~me.variant.suffix~"-ann-fail", 1),
            "annFm": props.globals.getNode("/controls/indicators/mcdu-"~me.variant.suffix~"-ann-fm", 1),
            "annFm1": props.globals.getNode("/controls/indicators/mcdu-"~me.variant.suffix~"-ann-fm1", 1),
            "annFm2": props.globals.getNode("/controls/indicators/mcdu-"~me.variant.suffix~"-ann-fm2", 1),
            "annMsg1": props.globals.getNode("/controls/indicators/mcdu-"~me.variant.suffix~"-ann-msg", 1),
            "annMsg2": props.globals.getNode("/controls/indicators/mcdu-"~me.variant.suffix~"-ann-msg", 1),
            "annInd": props.globals.getNode("/controls/indicators/mcdu-"~me.variant.suffix~"-ann-ind", 1),
            "annRdy": props.globals.getNode("/controls/indicators/mcdu-"~me.variant.suffix~"-ann-rdy", 1),
            "annDash": props.globals.getNode("/controls/indicators/mcdu-"~me.variant.suffix~"-ann-dash", 1),
        };
        me.watchLEDs();
        var liners = ['0','1','1S','2','2S','3','3S','4','4S','5','5S','6','6S'];
        foreach (var j; liners) {
            var name = "line"~j;
            var color = name~"_color";
            var sizer = name~"_size";
            me._inputProps[name] = props.globals.getNode("/MCDU["~me.variant.mcdu~"]/text/"~name,1);
            me._inputProps[name].setValue(";;");
            me._colorProps[color] = props.globals.getNode("/MCDU["~me.variant.mcdu~"]/text/"~color,1);
            me._colorProps[color].setValue("wht;wht;wht");
            me._sizeProps[sizer] = props.globals.getNode("/MCDU["~me.variant.mcdu~"]/text/"~sizer,1);
            me._sizeProps[sizer].setValue("60;60;60");
        }
        me._inputProps["scratchpad"] = props.globals.getNode("/MCDU["~me.variant.mcdu~"]/text/scratchpad",1);
        me._inputProps["scratchpad"].setValue("");
        me._colorProps["scratchpad"] = props.globals.getNode("/MCDU["~me.variant.mcdu~"]/text/scratchpad_color",1);
        me._colorProps.scratchpad.setValue('wht');
        foreach(var mcduLine; keys(me._inputProps)) {
            append(me.listeners,setlistener(me._inputProps[mcduLine],func() { me.updateLines();},0,0));
        }
        foreach(var mcduLine; keys(me._colorProps)) {
            append(me.listeners,setlistener(me._colorProps[mcduLine],func() { me.updateLines();},0,0));
        }
    },
    doOthers: func() {
        # setup the props like airbus to do the formatting the same
        var liners = ['0','1','1S','2','2S','3','3S','4','4S','5','5S','6','6S'];
        foreach (var j; liners) {
            var name = "line"~j;
            var color = name~"_color";
            var sizer = name~"_size";
            me._inputProps[name] = props.globals.getNode(me.path~me.variant.mcdu~"/text/"~name,1);
            me._inputProps[name].setValue(";;");
            me._colorProps[color] = props.globals.getNode(me.path~me.variant.mcdu~"/text/"~color,1);
            me._colorProps[color].setValue("wht;wht;wht");
            me._sizeProps[sizer] = props.globals.getNode(me.path~me.variant.mcdu~"/text/"~sizer,1);
            me._sizeProps[sizer].setValue("60;60;60");
        }
        me._inputProps["scratchpad"] = props.globals.getNode(me.path~me.variant.mcdu~"/text/scratchpad",1);
        me._inputProps["scratchpad"].setValue("");
        me._colorProps["scratchpad"] = props.globals.getNode(me.path~me.variant.mcdu~"/text/scratchpad_color",1);
        me._colorProps.scratchpad.setValue('wht');
        foreach(var mcduLine; keys(me._inputProps)) {
            append(me.listeners,setlistener(me._inputProps[mcduLine],func() { me.updateLines();},0,0));
        }
        foreach(var mcduLine; keys(me._colorProps)) {
            append(me.listeners,setlistener(me._colorProps[mcduLine],func() { me.updateLines();},0,0));
        }
    },
    initMsg: func() {
        # TODO - make this work without the doAirbus props
        me._inputProps.line0.setValue("FGFS MCDU");
        var airc = split('.',getprop("/sim/aircraft"))[-1];
        if (me.type == 'A320') {
            me._inputProps.line1.setValue("INIT;...;OK");
            me._colorProps.line1_color.setValue("wht;amb;grn");
            me._inputProps.line2S.setValue(";"~me.variant.name~";");
            me._inputProps.line2.setValue(";"~airc~";");
            me._colorProps.line2_color.setValue("wht;blu;wht");
            me._inputProps.line3.setValue(";MOSTLY WORKING;");
            me._colorProps.line3_color.setValue("wht;grn;wht");
        } else {
            me._inputProps.line1.setValue("INIT;...;INOP");
            me._colorProps.line1_color.setValue("wht;amb;red");
            me._inputProps.line2S.setValue(";"~me.variant.name~";");
            me._inputProps.line2.setValue(";"~airc~";");
            me._colorProps.line2_color.setValue("wht;amb;wht");
            me._inputProps.line3.setValue(";UNSUPORTED;MCDU");
            me._colorProps.line3_color.setValue("wht;blu;blu");
        }
        me._inputProps.scratchpad.setValue("AWAITING INPUT...");
        var upd8 = me._mcduProps.update.getValue();
        me._mcduProps.update.setIntValue(math.mod(upd8+1,2));
    },
