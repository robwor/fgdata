<!--
  Cloud shapes and layers. See Docs/README.3DClouds and https://cloudatlas.wmo.int/

  Short explanation of the 10 cloud types:

  High altitude
  ci = Cirrus (wispy clouds at high altitude - not implemented here)
  cs = Cirrostratus (thin layer of high altitude clouds)
  cc = Cirrocumulus (thin patterned layer of high altitude clouds)

  Medium Altitude
  ns = Nimbostratus (rain cloud)
  ac = Altocumulus (regular pattern of cumulus)
  as = Altostratus (thin layer of cloud, sun just visible)

  Low altitude
  cb = Cumulonimbus (Thunderstorm cloud)
      cb-cal = Cumulonimbus Calvus (without amboss/anvil)
      cb-inc = Cumulonimbus Incus (with amboss/anvil)
  cu = Cumulus
      cu hum = Cumulus humilis (smallest one, only at fair, nice weather)
      cu med = Cumulus mediocris (middle)
      cu con = Cumulus congestus (the largest one, pre-stage of Cumulonimbus)
  st = Stratus
  sc = Stratocumulus
-->
