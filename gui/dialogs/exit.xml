<?xml version="1.0"?>

<?FlightGear-tr context="dialog-exit"?>

<PropertyList>
  <ui-version>2</ui-version>
  <name>exit</name>
  <!-- Given the “Exit FlightGear?” label, this seems to me to be a decent
       dialog title. -->
  <title translate="y">
    exit-dialog-title
    <?FlightGear-tr text="FlightGear"
      comment="This is the title of the Exit dialog."?>
  </title>
  <modal>false</modal>
  <layout>vbox</layout>

  <text>
    <name>exit-prompt</name>
    <label translate="y">
      exit-FlightGear-question-label
      <?FlightGear-tr text="Exit FlightGear?"?>
    </label>
  </text>

  <button-box>
    <button>
      <name>exit-button</name>
      <legend translate="y">
        exit-button-label
        <?FlightGear-tr text="Exit"?>
      </legend>
      <default>true</default>
      <button-role>accept</button-role>
      <binding>
        <command>exit</command>
      </binding>
      <binding>
        <command>dialog-close</command>
      </binding>
    </button>   
    
    <standard-button>
      <button-type>cancel</button-type>
    </standard-button>
  </button-box>

</PropertyList>
