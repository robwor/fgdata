<?xml version="1.0"?>
<PropertyList>
  <ui-version>2</ui-version>
  <name>exit</name>
  <modal>false</modal>
  <layout>vbox</layout>

  <text>
    <label>Exit FlightGear?</label>
  </text>

  <button-box>
    <button>
      <legend>Exit</legend>
      <default>true</default>
      <button-role>accept</button-role>
      <binding>
        <command>exit</command>
      </binding>
      <binding>
        <command>dialog-close</command>
      </binding>
    </button>   
    
    <standard-button>
      <button-type>cancel</button-type>
    </standard-button>
  </button-box>

</PropertyList>
