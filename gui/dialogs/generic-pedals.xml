<?xml version="1.0"?>
<!-- generic pedals test dialog -->
<PropertyList>
	<name>generic-pedals</name>
	<layout>vbox</layout>
	<group>
		<layout>hbox</layout>
		<text>
			<label>Generic pedals monitor</label>
		</text>
		<empty>
			<stretch>1</stretch>
		</empty>
		<button>
			<legend>X</legend>
			<key>Esc</key>
			<pref-width>20</pref-width>
			<pref-height>20</pref-height>
			<binding>
				<command>dialog-close</command>
			</binding>
		</button>
	</group>
	<hrule/>
    <group>
        <layout>vbox</layout>
        <group>
            <layout>hbox</layout>
            <slider>
                <vertical>1</vertical>
                <halign>center</halign>
                <name>brake-left</name>
                <label>L</label>
                <min>0</min>
                <max>1</max>
                <live>true</live>
                <property>/controls/gear/brake-left</property>
            </slider>
            <slider>
                <vertical>1</vertical>
                <halign>center</halign>
                <name>brake-right</name>
                <label>R</label>
                <min>0</min>
                <max>1</max>
                <live>true</live>
                <property>/controls/gear/brake-right</property>
            </slider>
        </group>
        <slider>
            <halign>center</halign>
            <name>rudder</name>
            <min>-1</min>
            <max>1</max>
            <live>true</live>
            <property>/controls/flight/rudder</property>
        </slider>
        <text>
            <label>Rudder</label>
        </text>
    </group>
</PropertyList>
