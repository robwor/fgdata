<?xml version="1.0"?>

<PropertyList>

  <name>vr-options</name>
  <modal>false</modal>
  <resizable>false</resizable>
  <layout>vbox</layout>
  <default-padding>3</default-padding>

  <empty>
    <stretch>true</stretch>
  </empty>

  <group>
    <layout>vbox</layout>
    <padding>6</padding>
    <checkbox>
      <halign>left</halign>
      <label>Enable VR</label>
      <property>/sim/vr/enabled</property>
      <live>false</live>
      <binding>
        <command>dialog-apply</command>
      </binding>
    </checkbox>
  </group>

  <text>
    <halign>center</halign>
    <label>OpenXR Information</label>
    <enable><property>/sim/vr/present</property></enable>
  </text>

  <group>
    <layout>vbox</layout>
    <border>10</border>
    <halign>center</halign>
    <default-padding>2</default-padding>


    <text>
      <halign>left</halign>
      <label>OpenXR Runtime: MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM</label>
      <format>OpenXR Runtime: %s</format>
      <property>/sim/vr/openxr/runtime/name</property>
      <live>true</live>
      <enable><property>/sim/vr/present</property></enable>
    </text>

    <text>
      <halign>left</halign>
      <label>OpenXR System: MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM</label>
      <format>OpenXR System: %s</format>
      <property>/sim/vr/openxr/system/name</property>
      <live>true</live>
      <enable><property>/sim/vr/present</property></enable>
    </text>

    <text>
      <halign>left</halign>
      <label>VR State: MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM</label>
      <format>VR State: %s</format>
      <property>/sim/vr/state-string</property>
      <live>true</live>
      <enable><property>/sim/vr/present</property></enable>
    </text>
    <text>
      <halign>left</halign>
      <label></label>
    </text>
    <text>
      <halign>left</halign>
      <label></label>
    </text>
  </group>

  <group>
    <layout>hbox</layout>
    <halign>left</halign>
    <default-padding>1</default-padding>
    <text>
      <label>  </label>
    </text>
    <checkbox>
      <halign>left</halign>
      <label>Desktop Mirror</label>
      <property>/sim/vr/mirror-enabled</property>
      <live>true</live>
      <binding>
        <command>dialog-apply</command>
      </binding>
      <binding>
        <command>nasal</command>
        <script>
          if (getprop("/sim/rendering/compositor-reload-required")) {
            fgcommand("reload-compositor");
          }
        </script>
      </binding>
    </checkbox>
  </group>

  <group>
    <layout>hbox</layout>
    <halign>left</halign>
    <default-padding>1</default-padding>
    <text>
      <label>Desktop mirror mode</label>
      <enable><property>/sim/vr/mirror-enabled</property></enable>
    </text>
    <empty><stretch>true</stretch></empty>
    <combo>
      <pref-width>250</pref-width>
      <live>true</live>
      <property>/sim/vr/mirror-mode</property>
      <enable><property>/sim/vr/mirror-enabled</property></enable>
      <value>AUTOMATIC</value>
      <value>NONE</value>
      <value>LEFT</value>
      <value>RIGHT</value>
      <value>LEFT_RIGHT</value>
      <binding>
        <command>dialog-apply</command>
      </binding>
      <binding>
        <command>nasal</command>
        <script>
          if (getprop("/sim/rendering/compositor-reload-required")) {
            fgcommand("reload-compositor");
          }
        </script>
      </binding>
    </combo>
    <!-- gap -->
    <text>
      <label> </label>
    </text>

  </group>

  <group>
    <layout>hbox</layout>
    <halign>left</halign>
    <default-padding>1</default-padding>
    <text>
      <label>  </label>
    </text>
    <checkbox>
      <halign>left</halign>
      <label>Head tracked sound (for headphones)</label>
      <property>/sim/sound/head-tracked</property>
      <live>true</live>
      <binding>
        <command>dialog-apply</command>
      </binding>
    </checkbox>
  </group>

  <group>
    <layout>hbox</layout>
    <halign>left</halign>
    <default-padding>1</default-padding>
    <text>
      <label>  </label>
    </text>
    <checkbox>
      <halign>left</halign>
      <label>Show 3D mouse cursor in VR</label>
      <property>/sim/vr/cursors/mouse[0]/show-vr-running</property>
      <live>true</live>
      <binding>
        <command>dialog-apply</command>
      </binding>
    </checkbox>
  </group>

  <group>
    <layout>hbox</layout>
    <halign>left</halign>
    <default-padding>1</default-padding>
    <text>
      <label>  </label>
    </text>
    <checkbox>
      <halign>left</halign>
      <label>Always show 3D mouse cursor</label>
      <property>/sim/vr/cursors/mouse[0]/show-always</property>
      <live>true</live>
      <binding>
        <command>dialog-apply</command>
      </binding>
    </checkbox>
  </group>

  <group>
    <layout>hbox</layout>
    <halign>left</halign>
    <default-padding>1</default-padding>
    <text>
      <label>  </label>
    </text>
    <checkbox>
      <halign>left</halign>
      <label>Enable 360 mouse when VR in use</label>
      <property>/sim/vr/cursors/mouse[0]/vr-mode-user-presence</property>
      <enable><property>/sim/vr/openxr/system/supports-user-presence</property></enable>
      <live>true</live>
      <binding>
        <command>dialog-apply</command>
      </binding>
    </checkbox>
  </group>

  <group>
    <layout>hbox</layout>
    <halign>left</halign>
    <default-padding>1</default-padding>
    <text>
      <label>  360 mouse sensitivity</label>
    </text>
    <slider>
      <name>vr-mouse-sensitivity</name>
      <min>0.01</min>
      <max>0.20</max>
      <step>0.01</step>
      <live>true</live>
      <property>/sim/vr/config/cursors/px-angle-deg</property>
      <binding>
        <command>dialog-apply</command>
        <object-name>vr-mouse-sensitivity</object-name>
      </binding>
    </slider>
    <text>
      <label>0.05 deg/px</label>
      <format>%.2f deg/px</format>
      <live>true</live>
      <property>/sim/vr/config/cursors/px-angle-deg</property>
    </text>
  </group>

  <empty>
    <stretch>true</stretch>
  </empty>

  <hrule/>

  <button>
    <legend>Close</legend>
    <default>true</default>
    <key>Esc</key>
    <binding>
      <command>dialog-close</command>
    </binding>
  </button>


</PropertyList>
