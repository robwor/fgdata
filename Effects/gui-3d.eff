<?xml version="1.0" encoding="utf-8"?>
<PropertyList>
  <name>Effects/gui-3d</name>
  <inherits-from>Effects/model-pbr-transparent</inherits-from>

  <parameters>
    <base-color-factor type="vec4d">1 1 1 1</base-color-factor>
    <emissive-factor type="vec3d">0.2 0.2 0.2</emissive-factor>
    <depth-offset type="float">-0.05</depth-offset>
    <alpha-cutoff type="float">0.01</alpha-cutoff>
    <!-- We add a fifth texture unit for the GUI buffer -->
    <texture n="5">
      <type>buffer</type>
      <buffer>gui</buffer>
      <filter>nearest</filter>
      <mag-filter>nearest</mag-filter>
      <wrap-s>clamp-to-edge</wrap-s>
      <wrap-t>clamp-to-edge</wrap-t>
    </texture>
  </parameters>

  <!-- override hdr-forward in model-pbr-transparent -->
  <technique n="128">
    <pass>
      <!-- source is premultiplied -->
      <blend>
        <source-rgb>one</source-rgb>
      </blend>
      <define n="300">
        <name>BLEND_PREMULTIPLIED</name>
      </define>
      <define n="301">
        <name>EMISSION_AFTER_EXPOSURE</name>
      </define>
      <texture-unit n="5">
        <unit>5</unit>
        <type><use>texture[5]/type</use></type>
        <image><use>texture[5]/image</use></image>
        <buffer><use>texture[5]/buffer</use></buffer>
        <filter><use>texture[5]/filter</use></filter>
        <mag-filter><use>texture[5]/mag-filter</use></mag-filter>
        <wrap-s><use>texture[5]/wrap-s</use></wrap-s>
        <wrap-t><use>texture[5]/wrap-t</use></wrap-t>
      </texture-unit>
      <!-- base_color_tex -->
      <uniform n="100">
        <value type="int">5</value>
      </uniform>
      <!-- emissive_tex -->
      <uniform n="103">
        <value type="int">5</value>
      </uniform>
    </pass>
  </technique>
</PropertyList>

