<PropertyList>
  <path>top-left.ac</path>

  <effect>
    <inherits-from>Effects/mouse-cursor</inherits-from>
    <object-name>cursor</object-name>
  </effect>

  <animation>
    <object-name>cursor</object-name>
    <type>rotate</type>
    <axis>
      <x>0</x>
      <y>0</y>
      <z>-1</z>
    </axis>
    <expression><value>180</value></expression>
  </animation>
</PropertyList>
