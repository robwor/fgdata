<?xml version="1.0" encoding="UTF-8"?>
<!--
Up-down cursor model (rotated version of left-right).

Copyright (C) 2025 James Hogan
GPL-2.0-or-later

-->
<PropertyList>
  <path>left-right.ac</path>

  <effect>
    <inherits-from>Effects/mouse-cursor</inherits-from>
    <object-name>cursor</object-name>
  </effect>

  <animation>
    <object-name>cursor</object-name>
    <type>rotate</type>
    <axis>
      <x>0</x>
      <y>0</y>
      <z>1</z>
    </axis>
    <expression><value>90</value></expression>
  </animation>
</PropertyList>
