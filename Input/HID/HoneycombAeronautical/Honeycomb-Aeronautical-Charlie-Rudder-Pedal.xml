<PropertyList>
  <vendor-id>294b</vendor-id>
  <model-id>1903</model-id>
  <vendor-name>honeycomb</vendor-name>
  <model-name>charlie</model-name>
  <name>Honeycomb Aeronautical Charlie Rudder Pedal</name>
  <device-dialog>generic-pedals</device-dialog>
  <debug-events type="bool">false</debug-events>
  <hid-debug-raw type="bool">false</hid-debug-raw>
  <event>
    <desc>Brake left</desc>
    <name>abs-z-translate</name>
    <min-range>0</min-range>
    <max-range>1023</max-range>
    <binding>
      <command>property-scale</command>
      <property>/controls/gear/brake-left</property>
      <offset>1</offset>
      <factor>0.5</factor>
    </binding>
  </event>
  <event>
    <desc>Brake right</desc>
    <name>abs-y-translate</name>
    <min-range>0</min-range>
    <max-range>1023</max-range>
    <binding>
      <command>property-scale</command>
      <property>/controls/gear/brake-right</property>
      <offset>1</offset>
      <factor>0.5</factor>
    </binding>
  </event>
  <event>
    <desc>Rudder</desc>
    <name>abs-x-translate</name>
    <min-range>0</min-range>
    <max-range>1023</max-range>
    <binding>
      <command>property-scale</command>
      <property>/controls/flight/rudder</property>
    </binding>
  </event>
</PropertyList>
