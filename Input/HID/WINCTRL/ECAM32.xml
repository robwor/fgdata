<PropertyList>
    <vendor-id>4098</vendor-id>
    <vendor-name>winctrl</vendor-name>
    <model-name>ecam32</model-name>
    <model-id>bb70</model-id>
    <name>Winwing WINWING ECAM</name>
    <debug-events type="bool">false</debug-events>
    <hid-debug-raw type="bool">false</hid-debug-raw>
    <nasal>
        <open>
            <![CDATA[
                logprint(LOG_DEBUG,"WINCTRL ECAM Nasal (event) open");
                ecam32 = input_helpers.winctrl.new("ecam32",cmdarg(),device);
            ]]>
        </open>
        <close>
            <![CDATA[
                logprint(LOG_DEBUG,"WINCTRL ECAM Nasal (event) close");
                #if (ishash(ecam32) and isfunc(ecam32['close']))
                ecam32.close(cmdarg());
            ]]>
        </close>
    </nasal>
