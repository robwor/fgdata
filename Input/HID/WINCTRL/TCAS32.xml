        <desc>TCAS 1</desc>
        <repeatable>false</repeatable>
        <binding>
            <command>nasal</command>
            <script>atc.transponderPanel.keypad(1);</script>
        </binding>
        <binding>
            <command>property-assign</command>
            <property>/input/winctrl/tcas32/buttons/squawk1</property>
           <value>1</value>
        </binding>
        <mod-up>
            <binding>
                <command>property-assign</command>
                <property>/input/winctrl/tcas32/buttons/squawk1</property>
                <value>0</value>
            </binding>
        </mod-up>
    </event>
