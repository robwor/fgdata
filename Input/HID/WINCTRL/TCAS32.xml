<PropertyList>
    <vendor-id>4098</vendor-id>
    <vendor-name>winctrl</vendor-name>
    <model-name>tcas32</model-name>
    <model-id>bb81</model-id>
    <name>Winwing WINCTRL 32 TCAS</name>
    <debug-events type="bool">false</debug-events>
    <hid-debug-raw type="bool">false</hid-debug-raw>
    <nasal>
        <open>
            <![CDATA[
                logprint(LOG_DEBUG,"WINCTRL TCAS Nasal (event) open");
                tcas32 = input_helpers.winctrl.new("tcas32",cmdarg(),device);
            ]]>
        </open>
        <close>
            <![CDATA[
                logprint(LOG_DEBUG,"WINCTRL TCAS Nasal (event) close");
                tcas32.close(cmdarg());
            ]]>
        </close>
    </nasal>
    <!-- HID BUTTONS  -->
    <event>
