********************************************
*
* Bindings for WINCRTL MCDU-32 OBSERVER
*
* THIS WILL NOT WORK UNTIL THE A320 SUPPORTS A 3rd MCDU!!!
*
********************************************
-->
<PropertyList include="MCDU32-common.xml">
    <vendor-name>winctrl</vendor-name>
    <model-name>mcdu32</model-name>
    <vendor-id>4098</vendor-id>
    <model-id>bb3e</model-id>
    <name>Winwing WINWING MCDU-32-OBSERVER</name>
    <name>Winwing WINCTRL 32 MCDU OBSERVER</name>
    <nasal>
        <open>
            <![CDATA[
                logprint(LOG_DEBUG,"WINCTRL MCDU Nasal (event) open");
                var mcdu32 = input_helpers.winctrl.new("mcdu32",cmdarg(),device,"obs");
                var MIDX = 2;
            ]]>
        </open>
        <close>
            <![CDATA[
                logprint(LOG_DEBUG,"WINCTRL MCDU Nasal (event) close");
                mcdu32.close(cmdarg());
            ]]>
        </close>
    </nasal>
</PropertyList>
