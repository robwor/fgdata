SPDX-FileCopyrightText: 2026 Kent Stevens (timeplt)

********************************************************************
*
* Bindings for Winwing WINWING URSA MINOR 32 Throttle Metal L
* 4098:b920
*
* Throttle descriptions
*  toga normal 65535 bt 12,18
*  mct noraml 55453 bt 13,19
*  cl normal 45371 bt 14,20
*  0 normal 20165 bt 15,21
*  0 reverse 14115 bt 16,22 40,41
*  max reverse 0 bt 17,23 40,41
* 
*  axis property scales
*  range of 0-65536 maps to -32767+32768 to -1 to 1 double
*  offset  = -32767 + 20165 / 32767
*  factor is close to 2*offset/32767
*
*  set detents in $FGHOME/Export/A320-family-config.xml
*  under <fadec> -b bottom, -t top
* 
*  still requires offsets for now
*
* LED Mappings
*    '_dev1': 0x10,
*    '_devB': 0x01, # PAC
*    '_dev2': 0xB9,
*    'panel': 0x00,
*    'panel2': 0x00,
*    'lcd': 0x02,
*    'fault1': 0x03,
*    'fire1': 0x04,
*    'fault2': 0x05,
*    'fire2': 0x06,
*    'vibR1': 0x10,
*    'vibR2': 0x11,
*    'vibL1': 0x12,
*    'vibL2': 0x13,
********************************************************************
-->

