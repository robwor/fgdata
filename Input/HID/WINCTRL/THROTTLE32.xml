    <event>
        <desc>ENG1 throttle</desc>
        <name>abs-x-rotate</name>
        <output-mode>signed-normalized</output-mode>
        <binding>
            <condition>
                <not>
                    <property>/input/winctrl/throttle32/buttons/reverser[0]</property>
                </not>
            </condition>
            <command>property-scale</command>
            <property>/input/winctrl/throttle32/thr0</property>
            <factor type="double">0.72210</factor>
            <offset type="double">0.38489</offset>
            <power type="double">1.0</power>
        </binding>
        <binding>
            <condition>
                <property>/input/winctrl/throttle32/buttons/reverser[0]</property>
            </condition>
            <command>property-scale</command>
            <property>/input/winctrl/throttle32/thr0</property>
            <factor type="double">-2.44</factor>
            <offset type="double">0.589</offset>
            <power type="double">1.0</power>
        </binding>
        <binding>
            <condition>
                <not>
                    <property>/input/winctrl/throttle32/buttons/reverser[2]</property>
                </not>
            </condition>
            <command>property-scale</command>
            <property>/input/winctrl/throttle32/thr2</property>
